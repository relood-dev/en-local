From 508e625a5e4734429d69e34f878931cf5c3e641c Mon Sep 17 00:00:00 2001
From: Relood <147659633+relood-dev@users.noreply.github.com>
Date: Wed, 7 Oct 2026 20:26:11 +0200
Subject: [PATCH] En Local : Mii du joueur (ENLOCAL_MII)

---
 src/core/hle/applets/mii_selector.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/core/hle/applets/mii_selector.cpp b/src/core/hle/applets/mii_selector.cpp
index 0c17dc4..319835a 100644
--- a/src/core/hle/applets/mii_selector.cpp
+++ b/src/core/hle/applets/mii_selector.cpp
@@ -2,6 +2,8 @@
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
+#include <cstdlib>
+#include <cstring>
 #include <cstring>
 #include <string>
 #include <boost/crc.hpp>
@@ -116,6 +118,15 @@ MiiResult MiiSelector::GetStandardMiiResult() {
     mii_data.mole_details.raw = 0x4850;
     mii_data.author_name = {u'f', u'l', u'T', u'o', u'b', u'i'};
 
+    // En Local: the player's Mii, made in En Local (96 bytes in hexadecimal).
+    if (const char* hex = std::getenv("ENLOCAL_MII"); hex && std::strlen(hex) == 192) {
+        auto* raw = reinterpret_cast<u8*>(&mii_data);
+        for (std::size_t i = 0; i < sizeof(mii_data); ++i) {
+            const char pair[3] = {hex[2 * i], hex[2 * i + 1], 0};
+            raw[i] = static_cast<u8>(std::strtoul(pair, nullptr, 16));
+        }
+    }
+
     MiiResult result;
     result.return_code = 0x0;
     result.is_guest_mii_selected = 0x0;
-- 
