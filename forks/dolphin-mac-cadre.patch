+      auto* const timer = new QTimer(this);
+      connect(timer, &QTimer::timeout, this,
+              [this, path = std::string(menu), pause = false]() mutable {
+                const bool voulu = File::Exists(path) && !Settings::Instance().GetNetPlayClient();
+                if (voulu == pause || Core::GetState(m_system) == Core::State::Uninitialized)
+                  return;
+                pause = voulu;
+                Core::SetState(m_system, pause ? Core::State::Paused : Core::State::Running);
+              });
+      timer->start(100);
+    }
+    suivie = true;
+#else
     m_render_widget->windowHandle()->setParent(QWindow::fromWinId(s_embed_parent));
     m_render_widget->move(0, 0);
     m_render_widget->show();
+#endif
