+                const QStringList v = line.split(QLatin1Char(' '), Qt::SkipEmptyParts);
+                if (v.size() < 4 || v[2].toInt() <= 0 || v[3].toInt() <= 0)
+                  return;
+                const QRect r(v[0].toInt(), v[1].toInt(), v[2].toInt(), v[3].toInt());
+                if (r != place)
+                {
+                  place = r;
+                  m_render_widget->setGeometry(r);
+                }
