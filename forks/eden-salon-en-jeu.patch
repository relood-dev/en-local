+// En Local : entre dans un salon (au lancement avec --join, ou en cours de partie par le fichier
+// ENLOCAL_SALON). `places` > 0 : ce jeu héberge le salon lui-même (« Sur mon PC », comme Host Room).
+// L'ancien salon est quitté d'abord. Le salon de l'hôte n'existe qu'une fois son jeu lancé : on
+// réessaie d'y entrer pendant 2 min.
+static void EnLocalSalon(std::string host, u16 port, std::string nickname, std::string password, int places) {
+    if (auto member = Network::GetRoomMember().lock(); member && member->IsConnected())
+        member->Leave();
+    if (auto room = Network::GetRoom().lock(); room && room->GetState() == Network::Room::State::Open)
+        room->Destroy();
+    if (places > 0) {
+        if (auto room = Network::GetRoom().lock()) {
+            const bool cree = room->Create("En Local", "", "", port, password, static_cast<u32>(places), nickname, {},
+                                           std::make_unique<Network::VerifyUser::NullBackend>(), {});
+            LOG_INFO(Network, "En Local : salon hébergé par le jeu sur le port {} : {}", port, cree);
+        }
+    }
+    (void)QtConcurrent::run([=] {
+        for (int essai = 0; essai < 40; ++essai) {
+            auto member = Network::GetRoomMember().lock();
+            if (!member || member->IsConnected())
+                return;
+            member->Join(nickname, host.c_str(), port, 0, Network::NoPreferredIP, password);
+            for (int k = 0; k < 50 && member->GetState() == Network::RoomMember::State::Joining; ++k)
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            if (member->IsConnected())
+                return;
+            std::this_thread::sleep_for(std::chrono::seconds(3));
+        }
+    });
+}
