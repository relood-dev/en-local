 #define NS_WINDOW_COLLECTION_BEHAVIOR_FULLSCREEN_PRIMARY (1 << 7)
 
+/* En Local (macOS) : la fenêtre du jeu s'affiche directement dans le cadre d'En Local, comme la fenêtre
+ * fille sous Windows. Fichier ENLOCAL_CADRE : « x y largeur hauteur visible principale habillage »
+ * (points, origine en haut à gauche ; numéros des fenêtres d'En Local). Visible : juste au-dessus de la
+ * fenêtre principale, sous l'habillage. Sinon (menu ouvert, En Local caché ou réduit) : derrière tout.
+ * Les clics traversent vers En Local. ENLOCAL_MENU : pause tant que le fichier existe.
+ * ENLOCAL_VOLUME_FICHIER : volume des jeux réglé dans l'app, de 0 à 1, relu à chaque changement. */
+static char *enlocal_lire(const char *chemin, char *buf, size_t taille)
+{
+   FILE *f = fopen(chemin, "rb");
+   size_t n;
+   if (!f)
+      return NULL;
+   n = fread(buf, 1, taille - 1, f);
+   fclose(f);
+   buf[n] = '\0';
+   return buf;
+}
+
+static void enlocal_cadre(NSWindow *fenetre, const char *chemin)
+{
+   char buf[256];
+   long x = 0, y = 0, l = 0, h = 0, visible = 0, principale = 0, habillage = 0;
+   BOOL devant;
+   if (!enlocal_lire(chemin, buf, sizeof(buf))
+         || sscanf(buf, "%ld %ld %ld %ld %ld %ld %ld", &x, &y, &l, &h, &visible, &principale, &habillage) < 4)
+      return;
+   devant = visible == 1 && principale > 0
+      && [[NSWindow windowNumbersWithOptions:NSWindowNumberListAllApplications] containsObject:@(principale)];
+   if (l > 0 && h > 0)
+   {
+      /* Cocoa : origine en bas à gauche de l'écran principal. */
+      CGFloat haut = [[NSScreen screens] firstObject].frame.size.height;
+      NSRect voulu = NSMakeRect(x, haut - y - h, l, h);
+      if (!NSEqualRects(fenetre.frame, voulu))
+         [fenetre setFrame:voulu display:YES];
+   }
+   [fenetre setIgnoresMouseEvents:YES];
+   [fenetre setLevel:devant ? NSNormalWindowLevel : kCGDesktopWindowLevel + 1];
+   if (devant)
+      [fenetre orderWindow:NSWindowAbove relativeTo:principale];
+}
+
+static void enlocal_menu(const char *chemin)
+{
+   static int pause = 0;
+   struct stat st;
+   int voulu = stat(chemin, &st) == 0;
+   if (voulu == pause)
+      return;
+   pause = voulu;
+   command_event(pause ? CMD_EVENT_PAUSE : CMD_EVENT_UNPAUSE, NULL);
+}
+
+static void enlocal_volume(const char *chemin)
+{
+   static struct timespec lu;
+   struct stat st;
+   char buf[32];
+   double v;
+   settings_t *settings = config_get_ptr();
+   if (stat(chemin, &st) != 0
+         || (st.st_mtimespec.tv_sec == lu.tv_sec && st.st_mtimespec.tv_nsec == lu.tv_nsec))
+      return;
+   lu = st.st_mtimespec;
+   if (!enlocal_lire(chemin, buf, sizeof(buf)))
+      return;
+   v = atof(buf);
+   v = v < 0 ? 0 : v > 1 ? 1 : v;
+   settings->floats.audio_volume = v > 0.0001 ? (float)(20.0 * log10(v)) : -80.0f;
+   audio_set_float(AUDIO_ACTION_VOLUME_GAIN, settings->floats.audio_volume);
+}
+
+static void enlocal_demarrer(NSWindow *fenetre)
+{
+   const char *cadre  = getenv("ENLOCAL_CADRE");
+   const char *menu   = getenv("ENLOCAL_MENU");
+   const char *volume = getenv("ENLOCAL_VOLUME_FICHIER");
+   if (!cadre)
+      return;
+   /* App d'arrière-plan : pas d'icône dans le Dock, pas de barre de menus, ne prend jamais la main. */
+   [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+   /* Sans barre de titre ni bords (video_window_show_decorations n'est appliqué qu'au premier plan). */
+   fenetre.styleMask = NSWindowStyleMaskBorderless;
+   fenetre.hasShadow = NO;
+   /* Au départ juste au-dessus du bureau, derrière En Local, le temps que le jeu démarre. */
+   [fenetre setLevel:kCGDesktopWindowLevel + 1];
+   NSTimer *t = [NSTimer timerWithTimeInterval:0.05 repeats:YES block:^(NSTimer *timer) {
+      enlocal_cadre(fenetre, cadre);
+      if (menu)
+         enlocal_menu(menu);
+      if (volume)
+         enlocal_volume(volume);
+   }];
+   [[NSRunLoop mainRunLoop] addTimer:t forMode:NSRunLoopCommonModes];
+}
