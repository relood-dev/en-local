+using LibHac.Fs;
+using LibHac.Fs.Shim;
+using Ryujinx.Common.Logging;
+using Ryujinx.HLE.FileSystem;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Path = System.IO.Path;
+
+namespace Ryujinx.HLE
+{
+    /// <summary>
+    /// En Local (macOS) : les sauvegardes restent celles d'Eden, synchronisées avec les autres appareils.
+    /// ENLOCAL_EDEN_SAVES : dossier nand/user/save/0000000000000000 d'Eden ; ENLOCAL_EDEN_PROFIL : son profil
+    /// (32 chiffres hexadécimaux). Au lancement, la plus récente des deux copies l'emporte ; à la fermeture
+    /// de Ryujinx, la sienne repart chez Eden.
+    /// </summary>
+    public static class EnLocalSauvegardes
+    {
+        private static readonly List<(string Ryu, string Eden)> _paires = [];
+
+        public static void Lier(Switch device, ulong programId)
+        {
+            string eden = Environment.GetEnvironmentVariable("ENLOCAL_EDEN_SAVES");
+            string profil = Environment.GetEnvironmentVariable("ENLOCAL_EDEN_PROFIL");
+            if (string.IsNullOrEmpty(eden) || profil is not { Length: 32 } || !profil.All(Uri.IsHexDigit))
+            {
+                Logger.Warning?.Print(LogClass.Application, "En Local : profil Eden inconnu, sauvegardes non liées.");
+                return;
+            }
+
+            string titre = programId.ToString("X16");
+            UserId moi = device.System.AccountManager.LastOpenedUser.UserId.ToLibHac();
+            foreach ((SaveDataType type, UserId user, string dossier) in new[]
+            {
+                (SaveDataType.Account, moi, profil.ToUpperInvariant()),
+                (SaveDataType.Device, default(UserId), new string('0', 32)),
+            })
+            {
+                SaveDataFilter filtre = SaveDataFilter.Make(programId, type, user, saveDataId: default, index: default);
+                LibHac.Result r = device.System.LibHacHorizonManager.RyujinxClient.Fs.FindSaveDataWithFilter(out SaveDataInfo info, SaveDataSpaceId.User, in filtre);
+                if (r.IsFailure())
+                {
+                    Logger.Info?.Print(LogClass.Application, $"En Local : pas de sauvegarde {type} ({r.ToStringWithName()}).");
+                    continue;
+                }
+
+                string racine = Path.Combine(VirtualFileSystem.GetNandPath(), $"user/save/{info.SaveDataId:x16}");
+                (string Ryu, string Eden) p = (racine, Path.Combine(eden, dossier, titre));
+                try
+                {
+                    if (Recent(p.Eden) > Recent(Dossier(p.Ryu)))
+                    {
+                        Copier(p.Eden, Path.Combine(p.Ryu, "0"));
+                        // Le dossier de travail est refait depuis le dossier validé au montage.
+                        if (Directory.Exists(Path.Combine(p.Ryu, "1")))
+                        {
+                            Directory.Delete(Path.Combine(p.Ryu, "1"), true);
+                        }
+                        Logger.Info?.Print(LogClass.Application, $"En Local : sauvegarde d'Eden reprise ({type}).");
+                    }
+                    lock (_paires)
+                    {
+                        _paires.Add(p);
+                    }
+                    Logger.Info?.Print(LogClass.Application, $"En Local : sauvegarde {type} liée à Eden ({info.SaveDataId:x16}).");
+                }
+                catch (Exception e)
+                {
+                    Logger.Error?.Print(LogClass.Application, $"En Local : sauvegarde d'Eden non reprise : {e.Message}");
+                }
+            }
+
+            AppDomain.CurrentDomain.ProcessExit -= Rendre;
+            AppDomain.CurrentDomain.ProcessExit += Rendre;
+        }
+
+        /// <summary>À la fermeture : la sauvegarde de Ryujinx, si elle est plus récente, repart chez Eden.</summary>
+        public static void Rendre(object sender = null, EventArgs e = null)
+        {
+            lock (_paires)
+            {
+                foreach ((string ryu, string eden) in _paires)
+                {
+                    try
+                    {
+                        string source = Dossier(ryu);
+                        if (Directory.Exists(source) && Recent(source) > Recent(eden))
+                        {
+                            Copier(source, eden);
+                        }
+                    }
+                    catch (Exception ex)
+                    {
+                        Logger.Error?.Print(LogClass.Application, $"En Local : sauvegarde non rendue à Eden : {ex.Message}");
+                    }
+                }
+            }
+        }
+
+        /// <summary>Dossier validé (0) s'il existe, sinon celui de travail (1) : celui que Ryujinx monte.</summary>
+        private static string Dossier(string racine) =>
+            Directory.Exists(Path.Combine(racine, "0")) ? Path.Combine(racine, "0") : Path.Combine(racine, "1");
+
+        private static bool Interne(string chemin) => Path.GetFileName(chemin).StartsWith(".yuzu", StringComparison.Ordinal);
+
+        private static DateTime Recent(string dossier) =>
+            Directory.Exists(dossier)
+                ? Directory.EnumerateFiles(dossier, "*", SearchOption.AllDirectories).Where(f => !Interne(f)).Select(File.GetLastWriteTimeUtc).DefaultIfEmpty(DateTime.MinValue).Max()
+                : DateTime.MinValue;
+
+        /// <summary>Copie à l'identique (les fichiers en trop sont retirés), sauf les fichiers internes d'Eden.</summary>
+        private static void Copier(string source, string cible)
+        {
+            Directory.CreateDirectory(cible);
+            HashSet<string> gardes = [];
+            foreach (string f in Directory.EnumerateFiles(source, "*", SearchOption.AllDirectories))
+            {
+                if (Interne(f))
+                {
+                    continue;
+                }
+                string rel = Path.GetRelativePath(source, f);
+                string dest = Path.Combine(cible, rel);
+                Directory.CreateDirectory(Path.GetDirectoryName(dest)!);
+                File.Copy(f, dest, true);
+                File.SetLastWriteTimeUtc(dest, File.GetLastWriteTimeUtc(f));
+                gardes.Add(rel);
+            }
+            foreach (string f in Directory.EnumerateFiles(cible, "*", SearchOption.AllDirectories).ToList())
+            {
+                if (!Interne(f) && !gardes.Contains(Path.GetRelativePath(cible, f)))
+                {
+                    File.Delete(f);
+                }
+            }
+        }
+    }
+}
