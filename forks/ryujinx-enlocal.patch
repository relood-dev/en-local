+using Avalonia.Controls;
+using Avalonia.Threading;
+using Ryujinx.Ava.Common.Models;
+using Ryujinx.Ava.Systems.AppLibrary;
+using Ryujinx.Ava.Systems;
+using Ryujinx.Ava.Systems.Configuration;
+using Ryujinx.Ava.Systems.Configuration.System;
+using Ryujinx.Ava.Systems.Configuration.UI;
+using Ryujinx.Ava.Common.Locale;
+using Ryujinx.Ava.UI.Windows;
+using Ryujinx.Ava.Utilities;
+using Ryujinx.Common.Configuration.Hid;
+using Ryujinx.Common.Configuration.Hid.Controller;
+using Ryujinx.Common.Logging;
+using Ryujinx.HLE.HOS.Services.Account.Acc;
+using Ryujinx.Input;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+
+namespace Ryujinx.Ava
+{
+    /// <summary>
+    /// En Local (macOS) : Ryujinx lancé par En Local, comme Eden. Sa fenêtre, sans cadre ni menus, se pose dans
+    /// le cadre d'En Local (fichier ENLOCAL_CADRE : « x y largeur hauteur visible principale habillage », en
+    /// points ; numéros des fenêtres d'En Local) : juste au-dessus de la fenêtre principale quand le jeu est
+    /// visible, derrière tout sinon. Les clics traversent vers En Local, qui garde le clavier. Le jeu se met en
+    /// pause tant que le fichier ENLOCAL_MENU existe. La première manette est le joueur 1.
+    /// </summary>
+    internal static class EnLocal
+    {
+        private static readonly string _cadre = Environment.GetEnvironmentVariable("ENLOCAL_CADRE");
+        private static readonly string _menu = Environment.GetEnvironmentVariable("ENLOCAL_MENU");
+        public static bool Actif => !string.IsNullOrEmpty(_cadre);
+
+        /// <summary>Première image du jeu : la fenêtre, transparente pendant le chargement de Ryujinx, devient visible.</summary>
+        public static bool Rendu { get; set; }
+
+        private static bool _enPause;
+        private static string _place;
+
+        /// <summary>Réglages imposés par En Local, avant le lancement du jeu.</summary>
+        public static void Regler()
+        {
+            ConfigurationState c = ConfigurationState.Instance;
+            c.System.EnableDockedMode.Value = Environment.GetEnvironmentVariable("ENLOCAL_EN_MAIN") != "1";
+            c.EnableDiscordIntegration.Value = false;
+            c.UpdateCheckerType.Value = UpdaterType.Off;
+            c.ShowConfirmExit.Value = false;
+            // Pas de fenêtre « manette » par-dessus tout : la manette est prise dès qu'elle s'allume.
+            c.System.IgnoreControllerApplet.Value = true;
+            c.RememberWindowState.Value = false;
+            // Langue et région du joueur (numéros de la Switch), interface comprise ; volume en %.
+            if (int.TryParse(Environment.GetEnvironmentVariable("ENLOCAL_LANGUE"), out int langue) && Enum.IsDefined(typeof(Language), langue))
+            {
+                c.System.Language.Value = (Language)langue;
+                string[] codes = ["ja_JP", "en_US", "fr_FR", "de_DE", "it_IT", "es_ES", "zh_CN", "ko_KR", "nl_NL", "pt_BR", "ru_RU"];
+                if (langue < codes.Length)
+                {
+                    c.UI.LanguageCode.Value = codes[langue];
+                    LocaleManager.Instance.LoadLanguage(codes[langue]);
+                }
+            }
+            if (int.TryParse(Environment.GetEnvironmentVariable("ENLOCAL_REGION"), out int region) && Enum.IsDefined(typeof(Region), region))
+            {
+                c.System.Region.Value = (Region)region;
+            }
+            if (int.TryParse(Environment.GetEnvironmentVariable("ENLOCAL_VOLUME"), out int volume) && volume is >= 0 and <= 100)
+            {
+                c.System.AudioVolume.Value = volume / 100f;
+            }
+        }
+
+        /// <summary>Le profil porte le pseudo du joueur, comme dans Eden.</summary>
+        public static void Profil(AccountManager comptes)
+        {
+            string pseudo = Environment.GetEnvironmentVariable("ENLOCAL_PSEUDO")?.Trim();
+            if (!string.IsNullOrEmpty(pseudo) && comptes.LastOpenedUser != null && comptes.LastOpenedUser.Name != pseudo)
+            {
+                comptes.SetUserName(comptes.LastOpenedUser.UserId, pseudo.Length > 32 ? pseudo[..32] : pseudo);
+            }
+        }
+
+        /// <summary>
+        /// Mise à jour et DLC du jeu : fichiers de ENLOCAL_CONTENUS (un par ligne). La mise à jour la plus
+        /// récente est choisie (En Local n'envoie que celle choisie par le joueur, s'il en a choisi une).
+        /// </summary>
+        public static void Contenus(ApplicationLibrary bibliotheque, ulong idBase)
+        {
+            string[] fichiers = (Environment.GetEnvironmentVariable("ENLOCAL_CONTENUS") ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries);
+            List<TitleUpdateModel> majs = [];
+            List<DownloadableContentModel> dlcs = [];
+            foreach (string f in fichiers.Where(File.Exists))
+            {
+                if (bibliotheque.TryGetTitleUpdatesFromFile(f, out List<TitleUpdateModel> u))
+                {
+                    majs.AddRange(u.Where(x => x.TitleIdBase == idBase));
+                }
+                if (bibliotheque.TryGetDownloadableContentFromFile(f, out List<DownloadableContentModel> d))
+                {
+                    dlcs.AddRange(d.Where(x => x.TitleIdBase == idBase));
+                }
+            }
+            TitleUpdateModel derniere = majs.MaxBy(x => x.Version);
+            TitleUpdatesHelper.SaveTitleUpdatesJson(idBase, majs.Select(x => (x, x == derniere)).ToList());
+            DownloadableContentsHelper.SaveDownloadableContentsJson(idBase, dlcs.Select(x => (x, true)).ToList());
+        }
+
+        /// <summary>Manettes : la première branchée est le joueur 1 (en mode portable, la console elle-même).</summary>
+        public static List<InputConfig> Manettes(IGamepadDriver pilote)
+        {
+            bool dock = ConfigurationState.Instance.System.EnableDockedMode.Value;
+            string[] ids = pilote.GamepadsIds.ToArray();
+            Logger.Info?.Print(LogClass.Application, $"En Local : {ids.Length} manette(s) : {string.Join(", ", ids)}");
+            foreach (string id in ids)
+            {
+                using IGamepad manette = pilote.GetGamepad(id);
+                if (manette == null)
+                {
+                    continue;
+                }
+                string nom = manette.Name ?? "";
+                Logger.Info?.Print(LogClass.Application, $"En Local : joueur 1 = {nom} ({id}), {(dock ? "dock" : "portable")}");
+                return
+                [
+                    InputConfigDefaults.CreateDefaultControllerConfiguration(id, nom,
+                        dock ? ControllerType.ProController : ControllerType.Handheld,
+                        dock ? PlayerIndex.Player1 : PlayerIndex.Handheld,
+                        nom.Contains("Nintendo", StringComparison.OrdinalIgnoreCase)),
+                ];
+            }
+            return [];
+        }
+
+        public static void Suivre(MainWindow fenetre)
+        {
+            fenetre.WindowDecorations = WindowDecorations.None;
+            fenetre.ViewModel.ShowMenuAndStatusBar = false;
+            Objc.Envoyer(Objc.Envoyer(Objc.Classe("NSApplication"), "sharedApplication"), "setActivationPolicy:", 1);
+            DispatcherTimer minuterie = new() { Interval = TimeSpan.FromMilliseconds(50) };
+            minuterie.Tick += (_, _) => Tour(fenetre);
+            minuterie.Start();
+        }
+
+        private static void Tour(MainWindow fenetre)
+        {
+            if (fenetre.ViewModel.ShowMenuAndStatusBar)
+            {
+                fenetre.ViewModel.ShowMenuAndStatusBar = false;
+            }
+
+            AppHost hote = fenetre.ViewModel.AppHost;
+            bool menu = !string.IsNullOrEmpty(_menu) && File.Exists(_menu);
+            if (hote != null && menu != _enPause)
+            {
+                _enPause = menu;
+                if (menu)
+                {
+                    hote.Pause();
+                }
+                else
+                {
+                    hote.Resume();
+                }
+            }
+
+            IntPtr ns = NsWindow(fenetre);
+            if (ns == IntPtr.Zero)
+            {
+                return;
+            }
+            Objc.Envoyer(ns, "setAlphaValue:", Rendu ? 1.0 : 0.0);
+
+            string ligne;
+            try
+            {
+                ligne = File.ReadAllText(_cadre).Trim();
+            }
+            catch (IOException)
+            {
+                return;
+            }
+            string[] v = ligne.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+            if (v.Length < 4 || !int.TryParse(v[0], out int x) || !int.TryParse(v[1], out int y) || !int.TryParse(v[2], out int l) || !int.TryParse(v[3], out int h) || l <= 0 || h <= 0)
+            {
+                return;
+            }
+            string place = string.Join(' ', v.Take(4));
+            if (place != _place)
+            {
+                _place = place;
+                // Points comptés depuis le haut de l'écran principal ; macOS compte depuis le bas.
+                IntPtr ecran = Objc.Envoyer(Objc.Envoyer(Objc.Classe("NSScreen"), "screens"), "objectAtIndex:", 0);
+                Objc.Rect cadre = Objc.Cadre(ecran, "frame");
+                Objc.PoserCadre(ns, new Objc.Rect(x, cadre.H - y - h, l, h));
+            }
+
+            long principale = v.Length > 5 && long.TryParse(v[5], out long n) ? n : 0;
+            bool devant = v.Length > 4 && v[4] == "1" && principale > 0 && Rendu;
+            if (devant)
+            {
+                // Fenêtres à l'écran, toutes apps confondues : celle d'En Local doit y être.
+                IntPtr liste = Objc.Envoyer(Objc.Classe("NSWindow"), "windowNumbersWithOptions:", 1);
+                IntPtr numero = Objc.Envoyer(Objc.Classe("NSNumber"), "numberWithLong:", principale);
+                devant = liste != IntPtr.Zero && Objc.Contient(liste, numero);
+            }
+            Objc.Envoyer(ns, "setIgnoresMouseEvents:", 1);
+            Objc.Envoyer(ns, "setLevel:", devant ? 0 : -2147483623L + 1);
+            if (devant)
+            {
+                Objc.Envoyer(ns, "orderWindow:relativeTo:", 1, principale);
+            }
+        }
+
+        private static IntPtr NsWindow(Window fenetre)
+        {
+            Avalonia.Platform.IPlatformHandle h = fenetre.TryGetPlatformHandle();
+            if (h == null || h.Handle == IntPtr.Zero)
+            {
+                return IntPtr.Zero;
+            }
+            return h.HandleDescriptor == "NSView" ? Objc.Envoyer(h.Handle, "window") : h.Handle;
+        }
+
+        private static class Objc
+        {
+            [StructLayout(LayoutKind.Sequential)]
+            public readonly record struct Rect(double X, double Y, double L, double H);
+
+            private const string Lib = "/usr/lib/libobjc.A.dylib";
+
+            [DllImport(Lib)]
+            private static extern IntPtr objc_getClass(string nom);
+
+            [DllImport(Lib)]
+            private static extern IntPtr sel_registerName(string nom);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern IntPtr Msg(IntPtr o, IntPtr s);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern IntPtr Msg(IntPtr o, IntPtr s, long a);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern IntPtr Msg(IntPtr o, IntPtr s, long a, long b);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern IntPtr Msg(IntPtr o, IntPtr s, IntPtr a);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern byte MsgB(IntPtr o, IntPtr s, IntPtr a);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern void MsgD(IntPtr o, IntPtr s, double a);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern Rect MsgRect(IntPtr o, IntPtr s);
+
+            [DllImport(Lib, EntryPoint = "objc_msgSend")]
+            private static extern void MsgPoserCadre(IntPtr o, IntPtr s, Rect r, byte afficher);
+
+            public static IntPtr Classe(string nom) => objc_getClass(nom);
+            public static IntPtr Envoyer(IntPtr o, string s) => Msg(o, sel_registerName(s));
+            public static IntPtr Envoyer(IntPtr o, string s, long a) => Msg(o, sel_registerName(s), a);
+            public static IntPtr Envoyer(IntPtr o, string s, long a, long b) => Msg(o, sel_registerName(s), a, b);
+            public static IntPtr Envoyer(IntPtr o, string s, IntPtr a) => Msg(o, sel_registerName(s), a);
+            public static void Envoyer(IntPtr o, string s, double a) => MsgD(o, sel_registerName(s), a);
+            public static bool Contient(IntPtr liste, IntPtr objet) => MsgB(liste, sel_registerName("containsObject:"), objet) != 0;
+            public static Rect Cadre(IntPtr o, string s) => MsgRect(o, sel_registerName(s));
+            public static void PoserCadre(IntPtr o, Rect r) => MsgPoserCadre(o, sel_registerName("setFrame:display:"), r, 1);
+        }
+    }
+}
