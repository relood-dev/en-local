+#!/bin/sh
+# En Local : ENet 1.3.18 (celui des salons d'Eden) en bibliothèque pour Ryujinx sur Mac.
+# Usage : build-enet.sh <dossier des sources d'enet 1.3.18>
+set -e
+OUT="$(cd "$(dirname "$0")" && pwd)"
+cd "$1"
+clang -dynamiclib -O2 -arch arm64 -Iinclude -DHAS_FCNTL=1 -DHAS_POLL=1 -DHAS_GETADDRINFO=1 -DHAS_GETNAMEINFO=1 \
+  -DHAS_INET_PTON=1 -DHAS_INET_NTOP=1 -DHAS_MSGHDR_FLAGS=1 -DHAS_SOCKLEN_T=1 -install_name @rpath/libenet.dylib \
+  callbacks.c compress.c host.c list.c packet.c peer.c protocol.c unix.c -o "$OUT/libenet.dylib"
diff --git a/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEden.cs b/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEden.cs
new file mode 100644
index 00000000..dbebe1ed
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEden.cs
@@ -0,0 +1,305 @@
+using Ryujinx.Common.Logging;
+using System;
+using System.Buffers.Binary;
+using System.Collections.Concurrent;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading;
+
+namespace Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.EnLocal
+{
+    /// <summary>
+    /// En Local : Ryujinx entre dans un salon d'Eden (serveur du Local ou PC de l'hôte), comme un Eden.
+    /// Variables : ENLOCAL_SALON_HOTE, ENLOCAL_SALON_PORT, ENLOCAL_SALON_PSEUDO, ENLOCAL_SALON_MDP.
+    /// Protocole des salons d'Eden (network/room.h, room_member.cpp) : ENet (1.3.18, un canal, paquets
+    /// fiables), chaque message commence par son type ; entiers en gros-boutiste, chaînes et listes
+    /// précédées de leur taille (u32).
+    /// </summary>
+    public sealed class SalonEden
+    {
+        private const byte JoinRequest = 1, JoinSuccess = 2, SetGameInfo = 4, ProxyPacket = 5, LdnPacket = 6,
+            NameCollision = 8, IpCollision = 9, VersionMismatch = 10, WrongPassword = 11, CloseRoom = 12,
+            RoomIsFull = 13, HostKicked = 15, HostBanned = 16, JoinSuccessAsMod = 24;
+        private const uint NetworkVersion = 1;
+
+        public static SalonEden Instance { get; private set; }
+
+        /// <summary>Salon demandé par En Local ? Alors Ryujinx y entre dès son lancement.</summary>
+        public static void Demarrer()
+        {
+            string hote = Environment.GetEnvironmentVariable("ENLOCAL_SALON_HOTE");
+            if (Instance != null || string.IsNullOrEmpty(hote) || !ushort.TryParse(Environment.GetEnvironmentVariable("ENLOCAL_SALON_PORT"), out ushort port))
+            {
+                return;
+            }
+            Instance = new SalonEden(hote, port, Environment.GetEnvironmentVariable("ENLOCAL_SALON_PSEUDO") ?? "Ryujinx", Environment.GetEnvironmentVariable("ENLOCAL_SALON_MDP") ?? "");
+        }
+
+        private readonly string _hote, _pseudo, _mdp;
+        private readonly ushort _port;
+        private readonly ConcurrentQueue<byte[]> _sortants = new();
+        private readonly ManualResetEventSlim _dedans = new(false);
+
+        /// <summary>Adresse attribuée par le salon (192.168.x.y), null tant qu'on n'y est pas.</summary>
+        public byte[] Ip { get; private set; }
+
+        /// <summary>Message LDN reçu : type, IP de l'envoyeur, IP visée, diffusion, données.</summary>
+        public event Action<byte, byte[], byte[], bool, byte[]> Ldn;
+
+        /// <summary>Paquet du jeu reçu : IP et port de l'envoyeur, IP et port visés, protocole (Eden), diffusion, données.</summary>
+        public event Action<byte[], ushort, byte[], ushort, byte, bool, byte[]> Proxy;
+
+        private SalonEden(string hote, ushort port, string pseudo, string mdp)
+        {
+            (_hote, _port, _pseudo, _mdp) = (hote, port, pseudo, mdp);
+            new Thread(Boucle) { Name = "EnLocal.SalonEden", IsBackground = true }.Start();
+        }
+
+        /// <summary>Attend d'être dans le salon (au plus `ms`).</summary>
+        public bool Attendre(int ms) => _dedans.Wait(ms);
+
+        public void EnvoyerLdn(byte type, byte[] destination, bool diffusion, byte[] donnees)
+        {
+            if (Ip == null)
+            {
+                return;
+            }
+            Ecrivain e = new();
+            e.U8(LdnPacket).U8(type).Brut(Ip).Brut(destination ?? new byte[4]).Bool(diffusion).Liste(donnees ?? []);
+            _sortants.Enqueue(e.Fin());
+        }
+
+        public void EnvoyerProxy(ushort portLocal, byte[] destination, ushort portDistant, byte protocole, bool diffusion, byte[] donnees)
+        {
+            if (Ip == null)
+            {
+                return;
+            }
+            Ecrivain e = new();
+            e.U8(ProxyPacket).U8(1).Brut(Ip).U16(portLocal).U8(1).Brut(destination).U16(portDistant).U8(protocole).Bool(diffusion).Liste(donnees);
+            _sortants.Enqueue(e.Fin());
+        }
+
+        private unsafe void Boucle()
+        {
+            if (Enet.enet_initialize() != 0)
+            {
+                Logger.Error?.Print(LogClass.ServiceLdn, "En Local : ENet n'a pas démarré, pas de salon.");
+                return;
+            }
+            IntPtr hote = Enet.enet_host_create(null, 1, 1, 0, 0);
+            // Le salon de l'hôte n'existe qu'une fois son jeu lancé : comme Eden, on réessaie pendant 2 min.
+            for (int essai = 0; essai < 40; essai++)
+            {
+                Enet.Adresse adresse = new() { Port = _port };
+                if (Enet.enet_address_set_host(&adresse, _hote) != 0)
+                {
+                    Logger.Error?.Print(LogClass.ServiceLdn, $"En Local : adresse du salon introuvable ({_hote}).");
+                    return;
+                }
+                IntPtr pair = Enet.enet_host_connect(hote, &adresse, 1, 0);
+                Enet.Evenement ev;
+                if (pair != IntPtr.Zero && Enet.enet_host_service(hote, &ev, 5000) > 0 && ev.Type == Enet.Connect)
+                {
+                    Ecrivain e = new();
+                    e.U8(JoinRequest).Chaine(_pseudo).Brut([0xFF, 0xFF, 0xFF, 0xFF]).U32(NetworkVersion).Chaine(_mdp).Chaine("");
+                    _sortants.Enqueue(e.Fin());
+                    _sortants.Enqueue(new Ecrivain().U8(SetGameInfo).Chaine("").U64(0).Chaine("").Fin());
+                    if (!Connecte(hote, pair))
+                    {
+                        return; // refusé par le salon : inutile de réessayer
+                    }
+                }
+                else if (pair != IntPtr.Zero)
+                {
+                    Enet.enet_peer_reset(pair);
+                }
+                Thread.Sleep(3000);
+            }
+        }
+
+        /// <summary>Dans le salon, jusqu'à la déconnexion. Faux si le salon nous refuse.</summary>
+        private unsafe bool Connecte(IntPtr hote, IntPtr pair)
+        {
+            while (true)
+            {
+                Enet.Evenement ev;
+                if (Enet.enet_host_service(hote, &ev, 5) > 0)
+                {
+                    if (ev.Type == Enet.Disconnect)
+                    {
+                        Logger.Warning?.Print(LogClass.ServiceLdn, "En Local : déconnecté du salon, on y retourne.");
+                        Ip = null;
+                        _dedans.Reset();
+                        return true;
+                    }
+                    if (ev.Type == Enet.Receive)
+                    {
+                        byte[] octets = new ReadOnlySpan<byte>((void*)ev.Packet->Data, checked((int)ev.Packet->DataLength)).ToArray();
+                        Enet.enet_packet_destroy((IntPtr)ev.Packet);
+                        if (!Recevoir(octets))
+                        {
+                            Enet.enet_peer_disconnect(pair, 0);
+                            Enet.enet_host_flush(hote);
+                            return false;
+                        }
+                    }
+                }
+                while (_sortants.TryDequeue(out byte[] sortant))
+                {
+                    fixed (byte* p = sortant)
+                    {
+                        Enet.enet_peer_send(pair, 0, Enet.enet_packet_create(p, (nuint)sortant.Length, Enet.Reliable));
+                    }
+                }
+                Enet.enet_host_flush(hote);
+            }
+        }
+
+        /// <summary>Un message du salon. Faux s'il nous refuse.</summary>
+        private bool Recevoir(byte[] octets)
+        {
+            if (octets.Length == 0)
+            {
+                return true;
+            }
+            Lecteur l = new(octets, 1);
+            try
+            {
+                switch (octets[0])
+                {
+                    case JoinSuccess:
+                    case JoinSuccessAsMod:
+                        Ip = l.Brut(4);
+                        _dedans.Set();
+                        Logger.Info?.Print(LogClass.ServiceLdn, $"En Local : dans le salon {_hote}:{_port}, adresse {string.Join('.', Ip)}.");
+                        break;
+                    case LdnPacket:
+                    {
+                        byte type = l.U8();
+                        byte[] source = l.Brut(4), destination = l.Brut(4);
+                        bool diffusion = l.Bool();
+                        Ldn?.Invoke(type, source, destination, diffusion, l.Liste());
+                        break;
+                    }
+                    case ProxyPacket:
+                    {
+                        l.U8();
+                        byte[] source = l.Brut(4);
+                        ushort portSource = l.U16();
+                        l.U8();
+                        byte[] destination = l.Brut(4);
+                        ushort portDestination = l.U16();
+                        byte protocole = l.U8();
+                        bool diffusion = l.Bool();
+                        Proxy?.Invoke(source, portSource, destination, portDestination, protocole, diffusion, l.Liste());
+                        break;
+                    }
+                    case NameCollision:
+                    case IpCollision:
+                    case VersionMismatch:
+                    case WrongPassword:
+                    case RoomIsFull:
+                    case HostKicked:
+                    case HostBanned:
+                        Logger.Error?.Print(LogClass.ServiceLdn, $"En Local : le salon refuse l'entrée (message {octets[0]}).");
+                        Ip = null;
+                        return false;
+                    case CloseRoom:
+                        Logger.Warning?.Print(LogClass.ServiceLdn, "En Local : salon fermé.");
+                        Ip = null;
+                        _dedans.Reset();
+                        break;
+                }
+            }
+            catch (EndOfStreamException)
+            {
+                Logger.Warning?.Print(LogClass.ServiceLdn, $"En Local : message du salon tronqué (type {octets[0]}).");
+            }
+            return true;
+        }
+
+        /// <summary>Écriture d'un message de salon.</summary>
+        internal sealed class Ecrivain
+        {
+            private readonly MemoryStream _m = new();
+            public Ecrivain U8(byte v) { _m.WriteByte(v); return this; }
+            public Ecrivain Bool(bool v) => U8(v ? (byte)1 : (byte)0);
+            public Ecrivain U16(ushort v) { Span<byte> b = stackalloc byte[2]; BinaryPrimitives.WriteUInt16BigEndian(b, v); _m.Write(b); return this; }
+            public Ecrivain U32(uint v) { Span<byte> b = stackalloc byte[4]; BinaryPrimitives.WriteUInt32BigEndian(b, v); _m.Write(b); return this; }
+            public Ecrivain U64(ulong v) { Span<byte> b = stackalloc byte[8]; BinaryPrimitives.WriteUInt64BigEndian(b, v); _m.Write(b); return this; }
+            public Ecrivain Brut(byte[] v) { _m.Write(v); return this; }
+            public Ecrivain Liste(byte[] v) => U32((uint)v.Length).Brut(v);
+            public Ecrivain Chaine(string v) => Liste(Encoding.UTF8.GetBytes(v));
+            public byte[] Fin() => _m.ToArray();
+        }
+
+        /// <summary>Lecture d'un message de salon (EndOfStreamException s'il est tronqué).</summary>
+        internal sealed class Lecteur(byte[] octets, int debut)
+        {
+            private int _p = debut;
+            private ReadOnlySpan<byte> Prendre(int n)
+            {
+                if (n < 0 || n > octets.Length - _p)
+                {
+                    throw new EndOfStreamException();
+                }
+                _p += n;
+                return octets.AsSpan(_p - n, n);
+            }
+            public byte U8() => Prendre(1)[0];
+            public bool Bool() => U8() != 0;
+            public ushort U16() => BinaryPrimitives.ReadUInt16BigEndian(Prendre(2));
+            public uint U32() => BinaryPrimitives.ReadUInt32BigEndian(Prendre(4));
+            public byte[] Brut(int n) => Prendre(n).ToArray();
+            public byte[] Liste() => Brut(checked((int)U32()));
+        }
+    }
+
+    /// <summary>ENet 1.3.18 (libenet.dylib, à côté de Ryujinx), la bibliothèque réseau des salons d'Eden.</summary>
+    static unsafe class Enet
+    {
+        public const int Connect = 1, Disconnect = 2, Receive = 3;
+        public const uint Reliable = 1;
+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct Adresse
+        {
+            public uint Hote;
+            public ushort Port;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct Paquet
+        {
+            public nuint ReferenceCount;
+            public uint Flags;
+            public IntPtr Data;
+            public nuint DataLength;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        public struct Evenement
+        {
+            public int Type;
+            public IntPtr Peer;
+            public byte ChannelId;
+            public uint Data;
+            public Paquet* Packet;
+        }
+
+        private const string Lib = "enet";
+        [DllImport(Lib)] public static extern int enet_initialize();
+        [DllImport(Lib)] public static extern IntPtr enet_host_create(Adresse* adresse, nuint pairs, nuint canaux, uint entrant, uint sortant);
+        [DllImport(Lib)] public static extern int enet_address_set_host(Adresse* adresse, [MarshalAs(UnmanagedType.LPUTF8Str)] string nom);
+        [DllImport(Lib)] public static extern IntPtr enet_host_connect(IntPtr hote, Adresse* adresse, nuint canaux, uint donnee);
+        [DllImport(Lib)] public static extern int enet_host_service(IntPtr hote, Evenement* ev, uint attente);
+        [DllImport(Lib)] public static extern void enet_host_flush(IntPtr hote);
+        [DllImport(Lib)] public static extern IntPtr enet_packet_create(void* donnees, nuint taille, uint options);
+        [DllImport(Lib)] public static extern void enet_packet_destroy(IntPtr paquet);
+        [DllImport(Lib)] public static extern int enet_peer_send(IntPtr pair, byte canal, IntPtr paquet);
+        [DllImport(Lib)] public static extern void enet_peer_disconnect(IntPtr pair, uint donnee);
+        [DllImport(Lib)] public static extern void enet_peer_reset(IntPtr pair);
+    }
+}
diff --git a/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEdenClient.cs b/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEdenClient.cs
new file mode 100644
index 00000000..9830ae04
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/EnLocal/SalonEdenClient.cs
@@ -0,0 +1,412 @@
+using Ryujinx.Common.Logging;
+using Ryujinx.Common.Memory;
+using Ryujinx.HLE.HOS.Services.Ldn.Types;
+using Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.LdnRyu;
+using Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.LdnRyu.Proxy;
+using Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.LdnRyu.Types;
+using Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.Types;
+using Ryujinx.HLE.HOS.Services.Sockets.Bsd.Proxy;
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net.Sockets;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading;
+using ZstdSharp;
+
+namespace Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.EnLocal
+{
+    /// <summary>
+    /// En Local : le jeu sans fil local de Ryujinx passe par un salon d'Eden, comme celui d'Eden lui-même :
+    /// mêmes messages (core/hle/service/ldn/lan_discovery.cpp), mêmes structures nn::ldn (NetworkInfo,
+    /// NodeInfo), relayés par le salon. Celui qui crée la partie la tient à jour et l'envoie aux autres.
+    /// Les paquets du jeu (sockets UDP sur l'adresse du salon) passent par le salon, compressés en zstd
+    /// comme ceux d'Eden ; côté Ryujinx, par son proxy LDN (LdnProxy), décodé ici.
+    /// </summary>
+    sealed class SalonEdenClient : INetworkClient, IProxyClient
+    {
+        private const byte ScanLdn = 0, ScanResp = 1, ConnectLdn = 2, SyncNetwork = 3, DisconnectLdn = 4, DestroyNetwork = 5;
+        private const byte EdenTcp = 3, EdenUdp = 4;
+        private static readonly byte[] SsidEden = Encoding.ASCII.GetBytes("YuzuFakeSsidForLdn");
+
+        private readonly SalonEden _salon;
+        private readonly Lock _verrou = new();
+        // Le proxy de Ryujinx encode ses envois en protocole RyuLdn : relu ici, puis envoyé au salon.
+        private readonly RyuLdnProtocol _entree = new(), _sortie = new();
+        private readonly Dictionary<string, NetworkInfo> _trouves = new();
+        private readonly ManualResetEventSlim _synchro = new(false);
+
+        private NetworkInfo _reseau;
+        private NodeInfo _moi;
+        private bool _hote, _connecte;
+        private byte[] _ipHote;
+        private readonly List<byte[]> _clients = [];
+        private readonly bool[] _places = new bool[8];
+        private readonly LdnProxy _proxy;
+
+        public bool NeedsRealId => false; // comme Eden : l'identifiant de communication tel que le jeu le donne
+        public ProxyConfig Config { get; private set; }
+        public event EventHandler<NetworkChangeEventArgs> NetworkChange;
+
+        public SalonEdenClient(SalonEden salon)
+        {
+            _salon = salon;
+            _salon.Ldn += RecevoirLdn;
+            _salon.Proxy += RecevoirProxy;
+            _sortie.ProxyData += EnvoyerProxy;
+            if (_salon.Attendre(5000))
+            {
+                Config = new ProxyConfig { ProxyIp = BinaryPrimitives.ReadUInt32BigEndian(_salon.Ip), ProxySubnetMask = 0xFFFFFF00 };
+                _proxy = new LdnProxy(Config, this, _entree);
+                SocketHelpers.RegisterProxy(_proxy);
+            }
+            else
+            {
+                Logger.Warning?.Print(LogClass.ServiceLdn, "En Local : pas encore dans le salon.");
+            }
+        }
+
+        public void Dispose()
+        {
+            _salon.Ldn -= RecevoirLdn;
+            _salon.Proxy -= RecevoirProxy;
+            DisconnectNetwork();
+            SocketHelpers.UnregisterProxy();
+        }
+
+        private static byte[] Octets<T>(T valeur) where T : unmanaged => MemoryMarshal.AsBytes(new ReadOnlySpan<T>(ref valeur)).ToArray();
+
+        private static bool Lire<T>(byte[] donnees, out T valeur) where T : unmanaged
+        {
+            valeur = default;
+            if (donnees.Length < Marshal.SizeOf<T>())
+            {
+                return false;
+            }
+            valeur = MemoryMarshal.Read<T>(donnees);
+            return true;
+        }
+
+        private static string Cle(byte[] ip) => string.Join('.', ip);
+
+        /// <summary>Adresse du salon en entier (192.168.1.2 → 0xC0A80102), comme dans NodeInfo et chez Ryujinx.</summary>
+        private static uint Entier(byte[] ip) => BinaryPrimitives.ReadUInt32BigEndian(ip);
+        private static byte[] Ip(uint ip) => BitConverter.GetBytes(BinaryPrimitives.ReverseEndianness(ip));
+
+        private Array6<byte> Mac()
+        {
+            Array6<byte> mac = new();
+            mac[0] = 0x02;
+            mac[1] = 0x00;
+            _salon.Ip?.CopyTo(mac.AsSpan()[2..]);
+            return mac;
+        }
+
+        private NodeInfo Noeud(UserConfig utilisateur, ushort version)
+        {
+            NodeInfo n = new()
+            {
+                Ipv4Address = _salon.Ip == null ? 0 : Entier(_salon.Ip),
+                MacAddress = Mac(),
+                IsConnected = 1,
+                UserName = utilisateur.UserName,
+                LocalCommunicationVersion = version,
+            };
+            return n;
+        }
+
+        private void Changer(bool connecte, DisconnectReason raison = DisconnectReason.None)
+        {
+            _connecte = connecte;
+            NetworkChange?.Invoke(this, new NetworkChangeEventArgs(connecte ? _reseau : new NetworkInfo(), connecte, raison));
+        }
+
+        // --- Côté de celui qui crée la partie ---
+
+        public bool CreateNetwork(CreateAccessPointRequest request, byte[] advertiseData) =>
+            Creer(request.SecurityConfig, request.UserConfig, request.NetworkConfig, advertiseData);
+
+        public bool CreateNetworkPrivate(CreateAccessPointPrivateRequest request, byte[] advertiseData) =>
+            Creer(request.SecurityConfig, request.UserConfig, request.NetworkConfig, advertiseData);
+
+        private bool Creer(SecurityConfig securite, UserConfig utilisateur, NetworkConfig config, byte[] annonce)
+        {
+            if (_salon.Ip == null)
+            {
+                return false;
+            }
+            lock (_verrou)
+            {
+                _reseau = new NetworkInfo();
+                _reseau.Common.MacAddress = Mac();
+                _reseau.Common.Channel = config.Channel == 0 ? (ushort)6 : config.Channel;
+                _reseau.Common.LinkLevel = 2;
+                _reseau.Common.NetworkType = 2;
+                _reseau.Common.Ssid.Length = (byte)SsidEden.Length;
+                SsidEden.CopyTo(_reseau.Common.Ssid.Name.AsSpan());
+                _reseau.Ldn.NodeCountMax = config.NodeCountMax;
+                _reseau.Ldn.SecurityMode = (ushort)securite.SecurityMode;
+                Random.Shared.NextBytes(_reseau.NetworkId.SessionId.AsSpan());
+                _reseau.NetworkId.IntentId = config.IntentId;
+                for (int i = 0; i < 8; i++)
+                {
+                    _reseau.Ldn.Nodes[i].NodeId = (byte)i;
+                }
+                _moi = Noeud(utilisateur, config.LocalCommunicationVersion);
+                _reseau.Ldn.Nodes[0] = _moi;
+                PoserAnnonce(annonce ?? []);
+                _clients.Clear();
+                Array.Clear(_places);
+                _hote = true;
+                _reseau.Ldn.NodeCount = 1;
+                Changer(true);
+            }
+            return true;
+        }
+
+        private void PoserAnnonce(byte[] annonce)
+        {
+            int n = Math.Min(annonce.Length, _reseau.Ldn.AdvertiseData.Length);
+            _reseau.Ldn.AdvertiseData.AsSpan().Clear();
+            annonce.AsSpan(0, n).CopyTo(_reseau.Ldn.AdvertiseData.AsSpan());
+            _reseau.Ldn.AdvertiseDataSize = (ushort)n;
+        }
+
+        public void SetAdvertiseData(byte[] data)
+        {
+            lock (_verrou)
+            {
+                if (_hote)
+                {
+                    PoserAnnonce(data);
+                    Synchroniser();
+                }
+            }
+        }
+
+        /// <summary>Le réseau à jour, envoyé à chaque joueur et au jeu.</summary>
+        private void Synchroniser()
+        {
+            _reseau.Ldn.NodeCount = (byte)(1 + _places.Count(x => x));
+            byte[] info = Octets(_reseau);
+            foreach (byte[] ip in _clients)
+            {
+                _salon.EnvoyerLdn(SyncNetwork, ip, false, info);
+            }
+            Changer(true);
+        }
+
+        public ResultCode Reject(DisconnectReason disconnectReason, uint nodeId)
+        {
+            lock (_verrou)
+            {
+                if (!_hote || nodeId is 0 or > 7 || !_places[nodeId])
+                {
+                    return ResultCode.InvalidState;
+                }
+                byte[] ip = Ip(_reseau.Ldn.Nodes[(int)nodeId].Ipv4Address);
+                _salon.EnvoyerLdn(DestroyNetwork, ip, false, null);
+                _clients.RemoveAll(x => x.SequenceEqual(ip));
+                Liberer((int)nodeId);
+                Synchroniser();
+            }
+            return ResultCode.Success;
+        }
+
+        private void Liberer(int place)
+        {
+            _places[place] = false;
+            _reseau.Ldn.Nodes[place] = new NodeInfo { NodeId = (byte)place };
+        }
+
+        public void SetStationAcceptPolicy(AcceptPolicy acceptPolicy) { }
+
+        public void SetGameVersion(ReadOnlySpan<byte> versionString) { }
+
+        // --- Côté de ceux qui rejoignent ---
+
+        public NetworkInfo[] Scan(ushort channel, ScanFilter scanFilter)
+        {
+            lock (_verrou)
+            {
+                _trouves.Clear();
+            }
+            _salon.EnvoyerLdn(ScanLdn, null, true, null);
+            Thread.Sleep(1000); // comme Eden : les réponses arrivent pendant ce temps
+            lock (_verrou)
+            {
+                return _trouves.Values.Where(x => Garde(x, scanFilter)).ToArray();
+            }
+        }
+
+        private static bool Garde(NetworkInfo info, ScanFilter f)
+        {
+            if (f.Flag.HasFlag(ScanFilterFlag.LocalCommunicationId) && f.NetworkId.IntentId.LocalCommunicationId != info.NetworkId.IntentId.LocalCommunicationId)
+            {
+                return false;
+            }
+            if (f.Flag.HasFlag(ScanFilterFlag.SessionId) && !f.NetworkId.SessionId.AsSpan().SequenceEqual(info.NetworkId.SessionId.AsSpan()))
+            {
+                return false;
+            }
+            if (f.Flag.HasFlag(ScanFilterFlag.NetworkType) && (uint)f.NetworkType != info.Common.NetworkType)
+            {
+                return false;
+            }
+            if (f.Flag.HasFlag(ScanFilterFlag.Ssid) && (f.Ssid.Length != info.Common.Ssid.Length || !f.Ssid.Name.AsSpan()[..f.Ssid.Length].SequenceEqual(info.Common.Ssid.Name.AsSpan()[..info.Common.Ssid.Length])))
+            {
+                return false;
+            }
+            return !f.Flag.HasFlag(ScanFilterFlag.SceneId) || f.NetworkId.IntentId.SceneId == info.NetworkId.IntentId.SceneId;
+        }
+
+        public NetworkError Connect(ConnectRequest request)
+        {
+            if (_salon.Ip == null || request.NetworkInfo.Ldn.NodeCount == 0)
+            {
+                return NetworkError.ConnectFailure;
+            }
+            lock (_verrou)
+            {
+                _hote = false;
+                _moi = Noeud(request.UserConfig, (ushort)request.LocalCommunicationVersion);
+                _ipHote = Ip(request.NetworkInfo.Ldn.Nodes[0].Ipv4Address);
+                _synchro.Reset();
+            }
+            _salon.EnvoyerLdn(ConnectLdn, _ipHote, false, Octets(_moi));
+            return _synchro.Wait(4000) ? NetworkError.None : NetworkError.ConnectTimeout;
+        }
+
+        public NetworkError ConnectPrivate(ConnectPrivateRequest request) => NetworkError.ConnectNotFound;
+
+        public void DisconnectNetwork()
+        {
+            lock (_verrou)
+            {
+                if (_hote)
+                {
+                    foreach (byte[] ip in _clients)
+                    {
+                        _salon.EnvoyerLdn(DestroyNetwork, ip, false, null);
+                    }
+                    _clients.Clear();
+                    Array.Clear(_places);
+                    _hote = false;
+                }
+                else if (_ipHote != null)
+                {
+                    _salon.EnvoyerLdn(DisconnectLdn, _ipHote, false, Octets(_moi));
+                    _ipHote = null;
+                }
+                if (_connecte)
+                {
+                    Changer(false, DisconnectReason.DisconnectedByUser);
+                }
+            }
+        }
+
+        public void DisconnectAndStop() => DisconnectNetwork();
+
+        // --- Messages reçus du salon ---
+
+        private void RecevoirLdn(byte type, byte[] source, byte[] destination, bool diffusion, byte[] donnees)
+        {
+            lock (_verrou)
+            {
+                switch (type)
+                {
+                    case ScanLdn when _hote:
+                        _salon.EnvoyerLdn(ScanResp, source, false, Octets(_reseau));
+                        break;
+                    case ScanResp when Lire(donnees, out NetworkInfo trouve):
+                        _trouves[Cle(trouve.Common.MacAddress.AsSpan().ToArray())] = trouve;
+                        break;
+                    case ConnectLdn when _hote && Lire(donnees, out NodeInfo arrivant):
+                    {
+                        int place = Array.FindIndex(_places, 1, x => !x);
+                        if (place < 0 || place >= _reseau.Ldn.NodeCountMax)
+                        {
+                            break;
+                        }
+                        arrivant.NodeId = (byte)place;
+                        arrivant.IsConnected = 1;
+                        _reseau.Ldn.Nodes[place] = arrivant;
+                        _places[place] = true;
+                        _clients.RemoveAll(x => x.SequenceEqual(source));
+                        _clients.Add(source);
+                        Synchroniser();
+                        break;
+                    }
+                    case DisconnectLdn when _hote && Lire(donnees, out NodeInfo partant):
+                    {
+                        _clients.RemoveAll(x => x.SequenceEqual(source));
+                        for (int i = 1; i < 8; i++)
+                        {
+                            if (_places[i] && _reseau.Ldn.Nodes[i].MacAddress.AsSpan().SequenceEqual(partant.MacAddress.AsSpan()))
+                            {
+                                Liberer(i);
+                                break;
+                            }
+                        }
+                        Synchroniser();
+                        break;
+                    }
+                    case DestroyNetwork when !_hote && _connecte:
+                        _ipHote = null;
+                        Changer(false, DisconnectReason.DestroyedByUser);
+                        break;
+                    case SyncNetwork when !_hote && _ipHote != null && Lire(donnees, out NetworkInfo reseau):
+                        _reseau = reseau;
+                        Changer(true);
+                        _synchro.Set();
+                        break;
+                }
+            }
+        }
+
+        /// <summary>Paquet du jeu reçu d'un autre joueur : décompressé, puis remis au socket qui l'attend.</summary>
+        private void RecevoirProxy(byte[] source, ushort portSource, byte[] destination, ushort portDestination, byte protocole, bool diffusion, byte[] donnees)
+        {
+            byte[] brut;
+            try
+            {
+                using Decompressor d = new();
+                brut = d.Unwrap(donnees).ToArray();
+            }
+            catch (ZstdException)
+            {
+                return;
+            }
+            ProxyDataHeader entete = new()
+            {
+                Info = new ProxyInfo
+                {
+                    SourceIpV4 = Entier(source),
+                    SourcePort = portSource,
+                    DestIpV4 = diffusion && Config.ProxyIp != 0 ? Config.ProxyIp | ~Config.ProxySubnetMask : Entier(destination),
+                    DestPort = portDestination,
+                    Protocol = protocole == EdenTcp ? ProtocolType.Tcp : ProtocolType.Udp,
+                },
+                DataLength = (uint)brut.Length,
+            };
+            _proxy?.HandleData(default, entete, brut);
+        }
+
+        /// <summary>Envoi du proxy de Ryujinx (protocole RyuLdn) : relu, les données partent au salon.</summary>
+        public bool SendAsync(byte[] buffer)
+        {
+            _sortie.Read(buffer, 0, buffer.Length);
+            return true;
+        }
+
+        private void EnvoyerProxy(LdnHeader header, ProxyDataHeader entete, byte[] donnees)
+        {
+            using Compressor c = new(3);
+            byte[] destination = Ip(entete.Info.DestIpV4);
+            _salon.EnvoyerProxy(entete.Info.SourcePort, destination, entete.Info.DestPort,
+                entete.Info.Protocol == ProtocolType.Tcp ? EdenTcp : EdenUdp, destination[3] == 255, c.Wrap(donnees).ToArray());
+        }
+    }
+}
