@@ -1176,6 +1176,13 @@ namespace Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator
 
                         Logger.Info?.PrintMsg(LogClass.ServiceLdn, $"Initializing with multiplayer mode: {mode}");
 
