+global using Ryujinx.HLE.Loaders.Processes.Extensions;
+using LibHac.Common;
+using LibHac.Common.Keys;
+using LibHac.Fs;
+using LibHac.Fs.Fsa;
+using LibHac.FsSystem;
+using LibHac.Tools.FsSystem;
+using LibHac.Loader;
+using LibHac.Tools.FsSystem.NcaUtils;
+using System;
+
+namespace Ryujinx.HLE.Loaders.Processes.Extensions
+{
+    /// <summary>
+    /// En Local : le serveur NuGet de Ryubing (Ryujinx.LibHac 0.21) est hors ligne. Ce que la 0.21 a ajouté
+    /// à LibHac 0.20.0 (nuget.org), repris des extensions qu'avait Ryujinx avant le passage à la 0.21.
+    /// </summary>
+    public static class LibHacCompat
+    {
+        extension(Nca nca)
+        {
+            public ulong ProgramIdBase => nca.Header.TitleId & ~0x1FFFUL;
+            public int ProgramIndex => (int)(nca.Header.TitleId & 0xF);
+            public bool IsProgram => nca.Header.ContentType == NcaContentType.Program;
+            public bool IsPatch => nca.IsProgram && nca.SectionExists(NcaSectionType.Data)
+                && nca.Header.GetFsHeader(Nca.GetSectionIndexFromType(NcaSectionType.Data, NcaContentType.Program)).IsPatchSection();
+        }
+
+        extension(MetaLoader metaLoader)
+        {
+            public ulong ProgramId
+            {
+                get
+                {
+                    metaLoader.GetNpdm(out global::LibHac.Loader.Npdm npdm).ThrowIfFailure();
+                    return npdm.Aci.ProgramId.Value;
+                }
+            }
+
+            public bool IsProgram64Bit
+            {
+                get
+                {
+                    metaLoader.GetNpdm(out global::LibHac.Loader.Npdm npdm).ThrowIfFailure();
+                    return (npdm.Meta.Flags & 1) != 0;
+                }
+            }
+
+            public void LoadFromFile(IFileSystem fileSystem, string path = "")
+            {
+                if (string.IsNullOrEmpty(path))
+                {
+                    path = ProcessConst.MainNpdmPath;
+                }
+
+                using UniqueRef<IFile> npdmFile = new();
+                fileSystem.OpenFile(ref npdmFile.Ref, path.ToU8Span(), OpenMode.Read).ThrowIfFailure();
+                npdmFile.Get.GetSize(out long fileSize).ThrowIfFailure();
+                Span<byte> npdmBuffer = new byte[fileSize];
+                npdmFile.Get.Read(out _, 0, npdmBuffer).ThrowIfFailure();
+                metaLoader.Load(npdmBuffer).ThrowIfFailure();
+            }
+        }
+
+        public static Nca GetNca(this IFileSystem fileSystem, KeySet keySet, string path)
+        {
+            using UniqueRef<IFile> ncaFile = new();
+            fileSystem.OpenFile(ref ncaFile.Ref, path.ToU8Span(), OpenMode.Read).ThrowIfFailure();
+            return new Nca(keySet, ncaFile.Release().AsStorage());
+        }
+    }
+}
