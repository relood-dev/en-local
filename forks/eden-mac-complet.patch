+// En Local: the player's Mii (3DS / Wii U format, 96 bytes in hexadecimal), made in En Local.
+// Its create id comes from its own ids: the same Mii each time, replaced when it changes.
+void DatabaseManager::AddEnLocalMii() {
+    const char* hex = std::getenv("ENLOCAL_MII");
+    if (hex == nullptr || std::strlen(hex) != sizeof(Ver3StoreData) * 2) {
+        return;
+    }
+    Ver3StoreData ver3{};
+    auto* raw = reinterpret_cast<u8*>(&ver3);
+    for (std::size_t i = 0; i < sizeof(ver3); ++i) {
+        const char pair[3] = {hex[2 * i], hex[2 * i + 1], 0};
+        raw[i] = static_cast<u8>(std::strtoul(pair, nullptr, 16));
+    }
+    StoreData store_data{};
+    ver3.BuildToStoreData(store_data);
+    Common::UUID id{};
+    std::memcpy(id.uuid.data(), raw + 4, id.uuid.size());
+    id.uuid[6] = static_cast<u8>((id.uuid[6] & 0x0F) | 0x40);
+    id.uuid[8] = static_cast<u8>((id.uuid[8] & 0x3F) | 0x80);
+    store_data.SetCreateId(id);
+    if (store_data.IsValid() != ValidationResult::NoErrors) {
+        LOG_ERROR(Service_Mii, "En Local Mii is not valid");
+        return;
+    }
+    u32 index{};
+    if (database.GetIndexByCreatorId(index, id)) {
+        database.Replace(index, store_data);
+    } else if (!database.IsFull()) {
+        database.Add(store_data);
+    }
+    LOG_INFO(Service_Mii, "En Local Mii added");
+}
+
 bool DatabaseManager::IsFullDatabase() const {
     return database.GetDatabaseLength() == MaxDatabaseLength;
 }
