+// En Local: no Qt dialog inside its window, En Local shows its own keyboard (same files as the 3DS).
+// Request: max length, buttons (1 with Cancel), accepted input (0 any, 1 not empty, 4 exact length),
+// hint, error of the last answer. En Local answers in <file>.ok: "ok" or "annuler", then the text.
+static std::atomic<int> enlocal_ask{0};
+
+void QtSoftwareKeyboard::AskEnLocal(bool is_inline, u32 max, u32 min, std::u16string hint,
+                                    int error) const {
+    const auto& p = enlocal_params;
+    if (hint.empty()) {
+        hint = !p.header_text.empty() ? p.header_text : !p.guide_text.empty() ? p.guide_text : p.sub_text;
+    }
+    const QString path = qEnvironmentVariable("ENLOCAL_CLAVIER");
+    const QString ask = QStringLiteral("%1\n%2\n%3\n%4\n%5\n")
+                            .arg(max ? max : 500)
+                            .arg(p.disable_cancel_button ? 0 : 1)
+                            .arg(min == 0 ? 0 : min == max ? 4 : 1)
+                            .arg(QString::fromStdU16String(hint).simplified())
+                            .arg(error);
+    const int mine = ++enlocal_ask;
+    QPointer<QtSoftwareKeyboard> self(const_cast<QtSoftwareKeyboard*>(this));
+    std::thread([self, path, ask, is_inline, mine] {
+        QFile answer(path + QStringLiteral(".ok"));
+        answer.remove();
+        QFile f(path);
+        if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            f.write(ask.toUtf8());
+            f.close();
+        }
+        while (!answer.exists()) {
+            if (enlocal_ask != mine) {
+                return;
+            }
+            QThread::msleep(100);
+        }
+        QThread::msleep(50);
+        if (!answer.open(QIODevice::ReadOnly)) {
+            return;
+        }
+        const QString text = QString::fromUtf8(answer.readAll());
+        answer.close();
+        answer.remove();
+        QFile::remove(path);
+        const qsizetype sep = text.indexOf(QLatin1Char('\n'));
+        const bool ok = text.left(sep) == QStringLiteral("ok");
+        const std::u16string value = sep < 0 || !ok ? std::u16string{} : text.mid(sep + 1).toStdU16String();
+        LOG_INFO(Frontend, "En Local keyboard finished, button={}", ok ? "ok" : "cancel");
+        QMetaObject::invokeMethod(self.data(), [self, ok, value, is_inline] {
+            if (!self) {
+                return;
+            }
+            self->enlocal_text = value;
+            const auto cursor = static_cast<s32>(value.size());
+            if (!is_inline) {
+                self->submit_normal_callback(ok ? Service::AM::Frontend::SwkbdResult::Ok
+                                                : Service::AM::Frontend::SwkbdResult::Cancel,
+                                             value, false);
+            } else if (ok) {
+                self->submit_inline_callback(Service::AM::Frontend::SwkbdReplyType::ChangedString, value, cursor);
+                self->submit_inline_callback(Service::AM::Frontend::SwkbdReplyType::DecidedEnter, value, cursor);
+            } else {
+                self->submit_inline_callback(Service::AM::Frontend::SwkbdReplyType::DecidedCancel, value, cursor);
+            }
+        }, Qt::QueuedConnection);
+    }).detach();
+}
+
