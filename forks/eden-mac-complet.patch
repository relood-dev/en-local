+// En Local : un Joy-Con seul se tient sur le côté, le jeu tourne ses touches et son stick. La
+// manette (mappée comme une manette Pro) est tournée d'avance pour se tenir à l'endroit :
+// A B X Y à leur place, stick gauche, L et R pour SL et SR.
+static void EnLocalTourner(Core::HID::EmulatedController* pad, Core::HID::NpadStyleIndex type) {
+    using B = Settings::NativeButton::Values;
+    using A = Settings::NativeAnalog::Values;
+    if (pad->GetStickParam(A::LStick).Has("enlocal_tourne") || pad->GetStickParam(A::RStick).Has("enlocal_tourne"))
+        return;
+    const bool gauche = type == Core::HID::NpadStyleIndex::JoyconLeft;
+    std::array<Common::ParamPackage, Settings::NativeButton::NumButtons> b;
+    for (std::size_t k = 0; k < b.size(); ++k)
+        b[k] = pad->GetButtonParam(k);
+    const auto mettre = [&](B dest, B src) { pad->SetButtonParam(dest, b[src]); };
+    if (gauche) {
+        mettre(B::DDown, B::A), mettre(B::DLeft, B::B), mettre(B::DRight, B::X), mettre(B::DUp, B::Y);
+        mettre(B::SLLeft, B::L), mettre(B::SRLeft, B::R), mettre(B::Minus, B::Plus);
+    } else {
+        mettre(B::X, B::A), mettre(B::A, B::B), mettre(B::Y, B::X), mettre(B::B, B::Y);
+        mettre(B::SLRight, B::L), mettre(B::SRRight, B::R), mettre(B::RStick, B::LStick);
+    }
+    // Quart de tour, vérifié en jeu (Super Mario Party) : Joy-Con gauche (x, y) = (-haut, -droite),
+    // droit (x, y) = (haut, droite).
+    const auto u = pad->GetStickParam(A::LStick);
+    const auto inverse = [](const std::string& s) { return std::string(s == "-" ? "+" : "-"); };
+    const std::string ix = u.Get("invert_x", "+"), iy = u.Get("invert_y", "+");
+    auto t = u;
+    t.Set("axis_x", u.Get("axis_y", 1));
+    t.Set("axis_y", u.Get("axis_x", 0));
+    t.Set("offset_x", u.Get("offset_y", 0.0f));
+    t.Set("offset_y", u.Get("offset_x", 0.0f));
+    t.Set("invert_x", gauche ? inverse(iy) : iy);
+    t.Set("invert_y", gauche ? inverse(ix) : ix);
+    t.Set("enlocal_tourne", 1);
+    pad->SetStickParam(gauche ? A::LStick : A::RStick, t);
+    pad->SaveCurrentConfig();
+}
+
+// En Local : branche le joueur `i` (0 = joueur 1) dans le premier type que le jeu accepte, dans
+// l'ordre de la fenêtre de choix : Pro, paire de Joy-Con, Joy-Con seul (gauche aux joueurs
+// impairs, droit aux pairs). Un jeu peut refuser la manette Pro (Super Mario Party : Joy-Con seul).
+static bool EnLocalBrancher(Core::HID::EmulatedController* pad, std::size_t i,
+                            const std::function<bool(Core::HID::NpadStyleIndex)>& permis) {
+    using T = Core::HID::NpadStyleIndex;
+    const T seul = i % 2 == 0 ? T::JoyconLeft : T::JoyconRight;
+    for (const T type : {T::Fullkey, T::JoyconDual, seul, seul == T::JoyconLeft ? T::JoyconRight : T::JoyconLeft}) {
+        if (!permis(type))
+            continue;
+        pad->SetNpadStyleIndex(type);
+        pad->Connect();
+        if (pad->IsConnected()) {
+            if (type == T::JoyconLeft || type == T::JoyconRight)
+                EnLocalTourner(pad, type);
+            if (type != T::Fullkey)
+                LOG_INFO(Frontend, "En Local : joueur {} branché en type {}", i + 1, static_cast<int>(type));
+            return true;
+        }
+    }
+    return false;
+}
