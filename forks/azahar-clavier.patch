+// Request file: max length, buttons, accepted input, hint, error of the last answer.
+// En Local answers in <file>.ok: "ok" or "annuler", then the text. A refused text is asked again.
+void QtKeyboard::AskEnLocal(const QString& path) {
+    QFile answer(path + QStringLiteral(".ok"));
+    int error = 0;
+    for (;;) {
+        answer.remove();
+        QFile ask(path);
+        if (ask.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            const QString hint = QString::fromStdString(config.hint_text).simplified();
+            ask.write(QStringLiteral("%1\n%2\n%3\n%4\n%5\n")
+                          .arg(config.max_text_length)
+                          .arg(static_cast<int>(config.button_config))
+                          .arg(static_cast<int>(config.accept_mode))
+                          .arg(hint)
+                          .arg(error)
+                          .toUtf8());
+            ask.close();
+        }
+        while (!answer.exists()) {
+            QThread::msleep(100);
+        }
+        QThread::msleep(50);
+        if (!answer.open(QIODevice::ReadOnly)) {
+            continue;
+        }
+        const QString text = QString::fromUtf8(answer.readAll());
+        answer.close();
+        const qsizetype sep = text.indexOf(QLatin1Char('\n'));
+        const bool ok = text.left(sep) == QStringLiteral("ok");
+        const std::string value = sep < 0 ? std::string{} : text.mid(sep + 1).toStdString();
+        auto e = ok ? ValidateFilters(value) : Frontend::ValidationError::None;
+        if (e == Frontend::ValidationError::None && ok) {
+            e = ValidateInput(value);
+        }
+        if (e == Frontend::ValidationError::None) {
+            answer.remove();
+            QFile::remove(path);
+            LOG_INFO(Frontend, "En Local keyboard finished, button={}", ok ? "ok" : "cancel");
+            Finalize(ok ? value : std::string{}, ok ? ok_id : cancel_id);
+            return;
+        }
+        error = static_cast<int>(e);
+    }
+}
