From c9f632fd4fb615eb59643c91fbdae1b3682e3761 Mon Sep 17 00:00:00 2001
From: Relood <147659633+relood-dev@users.noreply.github.com>
Date: Thu, 1 Oct 2026 15:28:52 +0200
Subject: [PATCH 3/4]  En Local : options longues sans outil de compression

---
 src/citra_meta/main.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/citra_meta/main.cpp b/src/citra_meta/main.cpp
index 4965ca2..8e213c7 100644
--- a/src/citra_meta/main.cpp
+++ b/src/citra_meta/main.cpp
@@ -60,7 +60,16 @@ int main(int argc, char* argv[]) {
     }
 #endif
 
-    if (CitraCLI::CheckForOptions(CitraCLI::cli_capture_optstring, argc, argv)) {
+    // A frontend (--parent) passes long options such as --nickname: getopt would read them as
+    // clusters of short options (-n -i -c kname) and start the compression tool instead.
+    bool embedded = false;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--parent") == 0) {
+            embedded = true;
+        }
+    }
+
+    if (!embedded && CitraCLI::CheckForOptions(CitraCLI::cli_capture_optstring, argc, argv)) {
         return CitraCLI::ParseCommand(argc, argv);
     }
 
-- 
