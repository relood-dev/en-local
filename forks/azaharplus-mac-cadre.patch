+// En Local (macOS) : la fenêtre du jeu s'affiche directement dans le cadre d'En Local, comme la fenêtre
+// fille sous Windows. Fichier ENLOCAL_CADRE : « x y largeur hauteur visible principale habillage »
+// (points ; numéros des fenêtres d'En Local). Visible : juste au-dessus de la fenêtre principale, sous
+// l'habillage (contours arrondis, décor, widgets), qui flotte au-dessus. Sinon (menu ouvert, En Local
+// caché ou réduit) : derrière tout.
+// Les clics traversent vers En Local, qui garde le clavier.
+// En Local : volume des jeux réglé dans l'app, en direct (fichier ENLOCAL_VOLUME_FICHIER, de 0 à 1).
+// Rend le nouveau volume s'il a changé depuis la dernière lecture, sinon -1.
+static double EnLocalVolume() {
+    static QDateTime lu;
+    const char* f = std::getenv("ENLOCAL_VOLUME_FICHIER");
+    if (!f)
+        return -1;
+    const QFileInfo info(QString::fromUtf8(f));
+    if (!info.exists() || info.lastModified() == lu)
+        return -1;
+    lu = info.lastModified();
+    QFile fichier(info.filePath());
+    bool ok = false;
+    const double v = fichier.open(QIODevice::ReadOnly) ? QString::fromUtf8(fichier.readAll()).trimmed().toDouble(&ok) : -1;
+    return ok && v >= 0 && v <= 1 ? v : -1;
+}
 
+static void EnLocalPlacer(void* vue, const QStringList& v) {
+    using Envoi = void* (*)(void*, void*);
+    using EnvoiL = void* (*)(void*, void*, long);
+    using Contient = signed char (*)(void*, void*, void*);
+    using Ordre = void (*)(void*, void*, long, long);
+    const auto sel = [](const char* n) { return reinterpret_cast<void*>(sel_registerName(n)); };
+    const auto classe = [](const char* n) { return reinterpret_cast<void*>(objc_getClass(n)); };
+    void* const fenetre = reinterpret_cast<Envoi>(objc_msgSend)(vue, sel("window"));
+    if (!fenetre)
+        return;
+    const long principale = v.value(5).toLong();
+    bool devant = v.value(4) == QStringLiteral("1") && principale > 0;
+    if (devant) {
+        // Fenêtres à l'écran, toutes apps confondues : celle d'En Local doit y être.
+        void* const liste = reinterpret_cast<EnvoiL>(objc_msgSend)(classe("NSWindow"), sel("windowNumbersWithOptions:"), 1);
+        void* const n = reinterpret_cast<EnvoiL>(objc_msgSend)(classe("NSNumber"), sel("numberWithLong:"), principale);
+        devant = liste && reinterpret_cast<Contient>(objc_msgSend)(liste, sel("containsObject:"), n);
+    }
+    reinterpret_cast<EnvoiL>(objc_msgSend)(fenetre, sel("setIgnoresMouseEvents:"), 1);
+    reinterpret_cast<EnvoiL>(objc_msgSend)(fenetre, sel("setLevel:"), devant ? 0 : -2147483623L + 1);
+    if (devant)
+        reinterpret_cast<Ordre>(objc_msgSend)(fenetre, sel("orderWindow:relativeTo:"), 1, principale);
+}
+#endif
